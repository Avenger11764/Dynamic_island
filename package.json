{
  "name": "smart-notch",
  "private": true,
  "version": "7.0.6",
  "changelog": [
    "Much lighter on your PC: Smart Notch now uses a fraction of the processor it did, most of all while music is playing or the notch is open.",
    "Quieter in the background: Media, brightness and Bluetooth are followed through Windows events instead of constant checking.",
    "Calmer when paused: The album glow and Ambient effect now rest when your music is paused.",
    "Faster media response: Play, pause and track changes show up in the notch sooner."
  ],
  "main": "main.js",
  "author": "Avinash",
  "description": "Smart Notch – a Dynamic Island experience for Windows.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:start": "electron .",
    "pack": "vite build && electron-builder --dir",
    "dist": "vite build && electron-builder --win nsis",
    "store": "vite build && electron-builder --win appx"
  },
  "build": {
    "appId": "com.devavinash.smartnotch",
    "productName": "Smart Notch",
    "asarUnpack": [
      "*.ps1"
    ],
    "win": {
      "target": "appx",
      "icon": "assets/SmartNotch-icon.ico"
    },
    "appx": {
      "identityName": "Devavinash.DynamicIslandWindows",
      "publisher": "CN=AE5CAEC9-8659-4C4C-818A-0BB872795E9F",
      "publisherDisplayName": "Dev_avinash",
      "applicationId": "SmartNotch",
      "displayName": "Smart Notch",
      "backgroundColor": "#000000",
      "languages": [
        "en-US"
      ],
      "customManifestPath": "appxmanifest.xml"
    },
    "directories": {
      "output": "release",
      "buildResources": "store"
    },
    "files": [
      "main.js",
      "updater.js",
      "preload.js",
      "smtc-worker.js",
      "system_control.ps1",
      "open_media_tab.ps1",
      "build_dist/**/*",
      "node_modules/**/*"
    ]
  },
  "dependencies": {
    "@coooookies/windows-smtc-monitor": "^1.0.12",
    "dotenv": "^17.4.2",
    "framer-motion": "^11.0.0",
    "koffi": "^3.3.1",
    "loudness": "^0.4.2",
    "lucide-react": "^0.360.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "spotify-web-api-node": "^5.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "vite": "^8.0.8"
  }
}
